# greps the running process list for the value of $1
psgrep() {
    local name=$1
    ps aux | grep "${name}" | sed '$d'
    unset $name
}

# tries to unarchive anything thrown at it
unarchive() {
    local filename=$1
    local ext=${filename#*.}

    case "$ext" in
	tar)
	    tar xvf "$filename";;
	tar.gz)
	    tar xzvf "$filename";;
	tgz)
	    tar xzvf "$filename";;
	gz)
	    gunzip "$filename";;
	tbz)
	    tar xjvf "$filename";;
	tbz2)
	    tar xjvf "$filename";;
	tar.bz2)
	    tar xjvf "$filename";;
	tar.bz)
	    tar xjvf "$filename";;
	bz2)
	    bunzip2 "$filename";;
	tar.Z)
	    tar xZvf "$filename";;
	Z)
	    uncompress "$filename";;
	zip)
	    unzip "$filename";;
	rar)
	    unrar x "$filename";;
	*)
	    echo "$filename" does not have unarchive-able extension
    esac
}

# shorhand for xargs grep
function xg () {
  PAT="$1"
  shift
  xargs grep "$@" "$PAT" 2>&1 | less -p "$PAT"
}

# Unquoted $(...) is intended: one argument per container or image id.
# shellcheck disable=SC2046
dkillall() {
  docker kill $(docker ps -q)
}

# shellcheck disable=SC2046
drm() {
  docker rm $(docker ps -q -a)
}

# shellcheck disable=SC2046
dri() {
  docker rmi $(docker images -q)
}

db() {
  docker build -t="$1" .
}

# current kubectl context and namespace
kpwd () {
    kubectl config get-contexts | grep -F '*' | awk -F' ' '{print "(",$2,")", $5}'
}

# https://www.linuxjournal.com/content/validating-ip-address-bash-script
# Usage: if valid_ip IP_ADDRESS; then echo good; else echo bad; fi
function valid_ip()
{
    local  ip=$1
    local  stat=1

    if [[ $ip =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
        IFS=. read -r -a ip <<< "$ip"
        [[ ${ip[0]} -le 255 && ${ip[1]} -le 255 \
            && ${ip[2]} -le 255 && ${ip[3]} -le 255 ]]
        stat=$?
    fi
    return $stat
}

# https://stackoverflow.com/a/22625150/6831833
curltime () {
    curl -w @- -o /dev/null -s "$@" <<'CURL_FORMAT'
    time_namelookup:  %{time_namelookup}\n
       time_connect:  %{time_connect}\n
    time_appconnect:  %{time_appconnect}\n
   time_pretransfer:  %{time_pretransfer}\n
      time_redirect:  %{time_redirect}\n
 time_starttransfer:  %{time_starttransfer}\n
                    ----------\n
         time_total:  %{time_total}\n
CURL_FORMAT
}

function image_size () {
  docker manifest inspect -v $1 | grep size | awk -F ':' '{sum+=$NF} END {print sum}' | numfmt --to=iec-i
}
